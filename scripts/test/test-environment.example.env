# Copy this file to ../../.secrets/plane-test.env and keep the copy private.
# The repository root .gitignore excludes the complete .secrets directory.
PLANE_TEST_HOST=192.0.2.10
PLANE_TEST_SSH_PORT=22
PLANE_TEST_SSH_USER=root
PLANE_TEST_SSH_PASSWORD=replace-me
PLANE_TEST_SSH_HOST_KEY_SHA256=SHA256:replace-with-server-fingerprint

# This directory must be dedicated to Plane test deployments.
PLANE_TEST_REMOTE_ROOT=/opt/plane-test
PLANE_TEST_COMPOSE_PROJECT=plane-test

# The test server exposes Plane through these dedicated ports.
PLANE_TEST_HTTP_PORT=18080
# PLANE_TEST_PUBLIC_PORT=18080 is accepted as a legacy alias.
PLANE_TEST_HTTPS_PORT=18443
# Browser-facing origin through the SSH tunnel. Keep this stable so login
# redirects and cookies never point at the server's blocked public port.
PLANE_TEST_BASE_URL=http://localhost:8000
PLANE_TEST_KEEP_RELEASES=3
PLANE_TEST_BOOTSTRAP_RELEASE=stable

# Stable identities and fixture names. Leave passwords empty: the first real
# deploy generates strong values in .secrets/plane-test.env and reuses them.
PLANE_TEST_ADMIN_EMAIL=admin@plane.test
PLANE_TEST_ADMIN_PASSWORD=
PLANE_TEST_MEMBER_EMAIL=member@plane.test
PLANE_TEST_MEMBER_PASSWORD=
PLANE_TEST_GUEST_EMAIL=guest@plane.test
PLANE_TEST_GUEST_PASSWORD=
PLANE_TEST_WORKSPACE_NAME=AI Test Workspace
PLANE_TEST_WORKSPACE_SLUG=ai-test
PLANE_TEST_PROJECT_NAME=AI Acceptance
PLANE_TEST_PROJECT_IDENTIFIER=AITEST
PLANE_TEST_FIXTURE_VERSION=1

# Browser origins allowed to call the remote API during local UI development.
PLANE_TEST_LOCAL_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# On the first connection, save the server key under .runtime/test/ssh/.
# Later key changes are rejected. Set to 0 after the first successful connection.
PLANE_TEST_TRUST_ON_FIRST_USE=1
