{
  "name": "mcp",
  "version": "1.4.2",
  "private": true,
  "description": "A thin MCP server for Plane's external API",
  "license": "AGPL-3.0",
  "author": "Plane Software Inc.",
  "type": "module",
  "main": "./dist/start.mjs",
  "module": "./dist/start.mjs",
  "exports": {
    ".": "./dist/start.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "dev": "tsx watch src/start.ts",
    "start": "node .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
